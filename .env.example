# NEXUS-RAG Environment Configuration

PROJECT_NAME=NEXUS-RAG
ENVIRONMENT=development
DEBUG=True

# Pluggable LLM Providers: openai, anthropic, gemini, ollama, local_heuristic
LLM_PROVIDER=local_heuristic
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# Pluggable Embedding Providers: sentence_transformers, openai, fastembed, hash_mock
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Pluggable Rerankers: cross_encoder, heuristic, none
RERANKER_PROVIDER=cross_encoder
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Hybrid Retrieval Settings
DEFAULT_TOP_K=10
DEFAULT_RERANK_TOP_K=5
HYBRID_DENSE_WEIGHT=0.6
HYBRID_SPARSE_WEIGHT=0.4
RRF_K_CONSTANT=60

# Optional API Keys for Cloud Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Phase 5: Neo4j Knowledge Graph Intelligence
GRAPH_STORAGE_MODE=auto
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=nexus_graph_password
NEO4J_DATABASE=neo4j

# Phase 10: Security, Authentication & Cache
SECRET_KEY=your_secure_random_jwt_secret_key_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REDIS_URL=redis://localhost:6379/0


